{% extends "base.html" %}
{% block body %}
    {% if user %}
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">

            <!-- Monthly Cost -->
            <div>
              <div class="text-muted small text-uppercase">Monthly Cost</div>
              <div id="total-current-cost" class="fs-3 fw-bold text-danger">
                $0.00
              </div>
            </div>

            <!-- Total Resources -->
            <div>
              <div class="text-muted small text-uppercase">Total Resources</div>
              <div class="fs-3 fw-bold text-primary">
                {{ total_count or 0 }}
              </div>
            </div>

            <!-- Sort Button -->
            <div>
              <button class="btn btn-outline-primary"
                      onclick="sortCardsByCost()">
                Sort by Cost ↓
              </button>
            </div>

          </div>
        </div>

        <div class="row sticky-top m-2">
          <div class="col"></div>
          <div class="col-md-6 dropdown">
            <select id="filter" name="resource_type" class="form-select form-select-lg m-2"
              hx-get="/p"
              hx-include="#filter,#region_filter"
              hx-sync="#inventory:abort"
              hx-target="#inventory"
              hx-swap="innerHTML">
              <option value="all" {% if (current_resource_type | default('all')) == 'all' %}selected{% endif %}>All</option>
              {% for option in selections %}
              <option value="{{ option }}" {% if option == (current_resource_type | default('all')) %}selected{% endif %}>{{ option }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="col-md-2 dropdown">
            <select id="region_filter" name="region" class="form-select form-select-lg m-2"
              hx-get="/p"
              hx-include="#filter,#region_filter"
              hx-sync="#inventory:abort"
              hx-target="#inventory"
              hx-swap="innerHTML">
              {% for region in regions %}
              <option value="{{ region }}" {% if region == (current_region | default(home)) %}selected{% endif %}>{{ region }}</option>
              {% endfor %}
            </select>
          </div>
        </div>

        <span
            hx-get="/p"
            hx-include="#filter,#region_filter"
            hx-sync="#inventory:abort"
            hx-trigger="revealed once"
            hx-swap="innerHTML"
            hx-target="#inventory"></span>

        <div class="row">
          <div class="col-6">
            <p>Use the <strong class="text-danger">Delete</strong> button to mark a resource for deletion.</p>
          </div>
          <div class="col-6">
            <p>Use the <strong class="text-success">Extend</strong> button to set expiration {{ days }} from today.</p>
          </div>
        </div>
    {% endif %}

    <div id="inventory"></div>

    <!-- ✅ FIXED SORTING SCRIPT -->
    <script>
    function sortCardsByCost() {
        const container = document.getElementById("inventory");
        if (!container) return;

        const cards = Array.from(container.querySelectorAll("form.card"));

        // Separate non-card elements (like "End of results")
        const nonCards = Array.from(container.children).filter(el => !el.matches("form.card"));

        // Sort cards
        cards.sort((a, b) => {
            const costA = parseFloat(a.dataset.cost || 0);
            const costB = parseFloat(b.dataset.cost || 0);
            return costB - costA;
        });

        // Clear container
        container.innerHTML = "";

        // Add sorted cards
        cards.forEach(card => container.appendChild(card));

        // Add back non-card elements (like End of results)
        nonCards.forEach(el => container.appendChild(el));
    }

    // ✅ Auto re-sort after pagination loads new cards
    document.body.addEventListener('htmx:afterSwap', function(event) {
        if (event.target.id === 'inventory') {
            sortCardsByCost();
        }
    });
    </script>

{% endblock %}
