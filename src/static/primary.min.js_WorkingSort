(function(){const revertDelay=1500;function setStatus(button,text){if(!button){return}const originalText=button.getAttribute('data-original-text');if(!originalText){button.setAttribute('data-original-text',button.textContent.trim())}button.textContent=text;button.disabled=true;setTimeout(()=>{button.textContent=button.getAttribute('data-original-text');button.disabled=false},revertDelay)}document.addEventListener('click',async function(event){const button=event.target.closest('[data-copy-identifier]');if(!button){return}const cardForm=button.closest('form');if(!cardForm){return}const identifierInput=cardForm.querySelector('input[name="identifier"]');if(!identifierInput){return}const identifier=identifierInput.value;if(!identifier){return}try{await navigator.clipboard.writeText(identifier);setStatus(button,'Copied!')}catch(err){console.warn('Failed to copy identifier',err);setStatus(button,'Failed')}})})();(function(){const BATCH_SIZE=25;const MAX_CONCURRENT=2;const queue=[];const requested=new Set();const costsById=new Map();let inFlight=0;let flushTimer=null;const safeCurrency=(value)=>{const n=Number(value||0);if(!Number.isFinite(n))return '$0.00';return `$${n.toFixed(2)}`};const costBadgeId=(identifier)=>`cost-badge-${String(identifier||'').replaceAll('.', '-')}`;const setTotal=()=>{const el=document.getElementById('total-current-cost');if(!el)return;let total=0;for(const value of costsById.values()){total+=Number(value||0)}el.textContent=safeCurrency(total)};const paintBatch=(items)=>{(items||[]).forEach((item)=>{const identifier=item&&item.identifier;if(!identifier)return;const value=Number(item.current_cost||0);const safeValue=Number.isFinite(value)?value:0;costsById.set(identifier,safeValue);const badge=document.getElementById(costBadgeId(identifier));if(badge){badge.textContent=safeCurrency(safeValue);const card=badge.closest("form.card");if(card){card.dataset.cost=safeValue;console.log("DEBUG cost sync:",identifier,"=>",safeValue)}}});setTotal()};const flus