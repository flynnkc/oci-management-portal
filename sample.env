#!/bin/bash

export OCI_MGMT_DASH_URI="http://localhost:5000" # Optional
export OCI_MGMT_DASH_PROXY="false" # Set to true when app is behind an ingress that forwards X-Forwarded-Proto: https
export OCI_MGMT_DASH_SESSION_BACKEND="filesystem" # Optional: filesystem (single pod), redis, or valkey (multi-pod)
# export OCI_MGMT_DASH_SESSION_REDIS_URL="redis://redis:6379/0" # Required for redis/valkey backend
# export OCI_MGMT_DASH_SESSION_REDIS_USERNAME="default" # Optional: Redis ACL username
# export OCI_MGMT_DASH_SESSION_REDIS_PASSWORD="changeme" # Optional: Redis password (or ACL password)
# export OCI_MGMT_DASH_SESSION_KEY_PREFIX="omid:" # Optional
export OCI_MGMT_DASH_USER_SCOPED_OCI_CALLS="true" # Optional: run OCI calls with per-user token exchange signer
export OCI_MGMT_DASH_TOKEN_EXCHANGE_ENABLED="true" # Optional: required for USER_SCOPED_OCI_CALLS=true
# UPST signer cache behavior: local process memory only (no Redis/Valkey cache sharing).
# For USER_SCOPED_OCI_CALLS=true in multi-pod deployments, require sticky LB session affinity.
# For strict cache continuity, run one Gunicorn worker per pod (default in gunicorn.config.py).
# export OCI_MGMT_DASH_TOKEN_EXCHANGE_SCOPE="urn:opc:idm:__myscopes__" # Optional
# export OCI_MGMT_DASH_TOKEN_EXCHANGE_AUDIENCE="https://oraclecloud.com/" # Optional
# export OCI_MGMT_DASH_TOKEN_EXCHANGE_REQUESTED_TOKEN_TYPE="urn:ietf:params:oauth:token-type:access_token" # Optional
# export OCI_MGMT_DASH_TOKEN_EXCHANGE_SUBJECT_TOKEN_TYPE="urn:ietf:params:oauth:token-type:access_token" # Optional
# export OCI_MGMT_DASH_TOKEN_EXCHANGE_EXPIRY_SKEW_SECONDS="60" # Optional
export OCI_MGMT_DASH_TAG_NAMESPACE="Management"
export OCI_MGMT_DASH_TAG_KEY="Creator"
export OCI_MGMT_DASH_FILTER_NAMESPACE="Project" # Optional [Defaults to $OCI_MGMT_DASH_TAG_NAMESPACE]
export OCI_MGMT_DASH_FILTER_KEY="Expires"
export OCI_MGMT_DASH_CLEANUP_CMP="ocid1.compartment.oc1..abcdefg..."

export OCI_MGMT_DASH_AUTH_TYPE="Profile"
export OCI_MGMT_DASH_CONFIG_FILE="~/.oci/config" # Optional
export OCI_MGMT_DASH_PROFILE="DEFAULT" # Optional

export OCI_MGMT_DASH_IDM_ENDPOINT="https://idcs-xxxxxxxx.identity.oraclecloud.com:443"
export OCI_MGMT_DASH_CLIENT_ID="12345678"
export OCI_MGMT_DASH_CLIENT_SECRET="1234-5678-9012"

export OCI_MGMT_DASH_LOG_LEVEL="info" # Optional
#export OCI_MGMT_DASH_LOGFORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s" # Optional

# Multi-pod examples (use one backend + URL):
# Redis 7.0:
# export OCI_MGMT_DASH_SESSION_BACKEND="redis"
# export OCI_MGMT_DASH_SESSION_REDIS_URL="redis://redis-7-0.default.svc.cluster.local:6379/0"
# export OCI_MGMT_DASH_SESSION_REDIS_USERNAME="default"
# export OCI_MGMT_DASH_SESSION_REDIS_PASSWORD="<redis-password>"
# Valkey 7.2:
# export OCI_MGMT_DASH_SESSION_BACKEND="valkey"
# export OCI_MGMT_DASH_SESSION_REDIS_URL="redis://valkey-7-2.default.svc.cluster.local:6379/0"
# export OCI_MGMT_DASH_SESSION_REDIS_USERNAME="default"
# export OCI_MGMT_DASH_SESSION_REDIS_PASSWORD="<valkey-password>"
# Valkey 8.1:
# export OCI_MGMT_DASH_SESSION_BACKEND="valkey"
# export OCI_MGMT_DASH_SESSION_REDIS_URL="redis://valkey-8-1.default.svc.cluster.local:6379/0"
# export OCI_MGMT_DASH_SESSION_REDIS_USERNAME="default"
# export OCI_MGMT_DASH_SESSION_REDIS_PASSWORD="<valkey-password>"

# Optional Gunicorn overrides (defaults in src/gunicorn.config.py)
# export GUNICORN_BIND="0.0.0.0:5000"
# export GUNICORN_WORKERS="1"
# export GUNICORN_WORKER_CLASS="gthread"
# export GUNICORN_THREADS="4"
# export GUNICORN_LOG_LEVEL="info"
# export GUNICORN_MAX_REQUESTS="1000"
# export GUNICORN_MAX_REQUESTS_JITTER="50"
# export GUNICORN_TIMEOUT="600"
# export GUNICORN_GRACEFUL_TIMEOUT="60"
# export GUNICORN_KEEPALIVE="5"