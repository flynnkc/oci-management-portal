#!/bin/bash

###############################################################################
# OCI Management Portal - Sample Environment File
#
# Usage:
#   source sample.env
#
# Conventions used in this file:
# - Required: must be set for the app to start.
# - Optional: has a safe default in code.
# - Conditionally required: required only for certain modes.
###############################################################################

###############################################################################
# 1) Required core application + identity settings
###############################################################################

# Required: tag namespace and key used to identify managed resources.
export OCI_MGMT_DASH_TAG_NAMESPACE="Usage-Management"
export OCI_MGMT_DASH_TAG_KEY="Owner"

# Required: filter key used for expiry/lifecycle queries.
export OCI_MGMT_DASH_FILTER_KEY="Expires"

# Optional: defaults to OCI_MGMT_DASH_TAG_NAMESPACE when unset.
export OCI_MGMT_DASH_FILTER_NAMESPACE="Usage-Management"

# Required: target cleanup compartment OCID.
export OCI_MGMT_DASH_CLEANUP_CMP="ocid1.compartment.oc1..abcdefg..."

# Required: Identity Domain OIDC app settings.
export OCI_MGMT_DASH_IDM_ENDPOINT="https://idcs-xxxxxxxx.identity.oraclecloud.com:443"
export OCI_MGMT_DASH_CLIENT_ID="12345678"
export OCI_MGMT_DASH_CLIENT_SECRET="1234-5678-9012"
export OCI_MGMT_DASH_APP_URI="http://localhost:5000"
export OCI_MGMT_DASH_LOG_LEVEL="info"
export OCI_MGMT_DASH_AUTH_TYPE="profile"

###############################################################################
# 2) App runtime settings (optional)
###############################################################################

# Optional: externally reachable app URL used for callback generation.


# Optional: set true when behind trusted reverse proxy / ingress forwarding
# X-Forwarded-* headers.
export OCI_MGMT_DASH_PROXY="false"

# Optional logging controls.
# export OCI_MGMT_DASH_LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
# Optional: write application logs to this file instead of stdout/stderr.
# export OCI_MGMT_DASH_LOG_FILE="/var/log/oci-management-portal/app.log"

###############################################################################
# 3) OCI authentication mode settings
###############################################################################

# Optional: profile | instance_principal | delegation_token | workload_principal | resource_principal


# Optional: only used when AUTH_TYPE=profile.
export OCI_MGMT_DASH_CONFIG_FILE="~/.oci/config"
export OCI_MGMT_DASH_PROFILE="DEFAULT"

###############################################################################
# 4) Server-side session backend settings
###############################################################################

# Optional: filesystem (single pod), redis, or valkey.
export OCI_MGMT_DASH_SESSION_BACKEND="filesystem"

# Optional key prefix (used primarily for Redis/Valkey).
# export OCI_MGMT_DASH_SESSION_KEY_PREFIX="omid:"

# Conditionally required when SESSION_BACKEND is redis or valkey.
# export OCI_MGMT_DASH_SESSION_REDIS_URL="redis://redis:6379/0"
# export OCI_MGMT_DASH_SESSION_REDIS_USERNAME="default"
# export OCI_MGMT_DASH_SESSION_REDIS_PASSWORD="changeme"

###############################################################################
# 5) User-scoped OCI calls (UPST) settings
###############################################################################

# Optional: defaults to true. Set false to make Search/Delete/Extend and
# work-request polling use the app-scoped signer.
# export OCI_MGMT_DASH_USER_SCOPED_OCI_CALLS="false"

# Optional token exchange tuning.
# export OCI_MGMT_DASH_TOKEN_EXCHANGE_EXPIRY_SKEW_SECONDS="60"

# Operational note:
# - UPST access-token material is stored only in the server-side session backend.
# - User-scoped OCI signers are cached locally per token hash and region.
# - For multi-pod, use Redis/Valkey session storage and configure sticky affinity.

###############################################################################
# 6) Optional expired-resource notification report settings
###############################################################################

# Used by the Helm CronJob command:
#   python -m modules.reports.expired_resources_notification
#
# The notification topic must already exist and have confirmed email
# subscriptions.
# export OCI_MGMT_DASH_REPORT_NOTIFICATION_TOPIC_ID="ocid1.onstopic.oc1..example"
# Optional: publish in a specific region. Defaults to the signer/config region.
# export OCI_MGMT_DASH_REPORT_NOTIFICATION_REGION="us-ashburn-1"
# Optional: exact topic API endpoint from the topic details page.
# export OCI_MGMT_DASH_REPORT_NOTIFICATION_ENDPOINT="https://notification.us-ashburn-1.oci.oraclecloud.com"
# export OCI_MGMT_DASH_REPORT_NOTIFICATION_TITLE="OCI expired resources"
# Optional: comma-separated region names to search. Defaults to all subscribed READY regions.
# export OCI_MGMT_DASH_REPORT_REGIONS="us-ashburn-1,us-phoenix-1"
# Optional: limit detailed resource lines included in the notification body.
# export OCI_MGMT_DASH_REPORT_MAX_ITEMS="25"
# Owner entry point: python -m modules.reports.expired_resources_owner_notification
# export OCI_MGMT_DASH_REPORT_OWNER_COMPARTMENT_ID="ocid1.compartment.oc1..replace_me"
# export OCI_MGMT_DASH_REPORT_OWNER_TOPIC_PREFIX="gitdash-expiry"
# export OCI_MGMT_DASH_REPORT_OWNER_ALLOWED_DOMAINS="oracle.com"

###############################################################################
# 7) Optional Gunicorn overrides (defaults in src/gunicorn.config.py)
###############################################################################

# export GUNICORN_BIND="0.0.0.0:5000"
# export GUNICORN_WORKERS="1"
# export GUNICORN_WORKER_CLASS="gthread"
# export GUNICORN_THREADS="4"
# export GUNICORN_LOG_LEVEL="info"
# export GUNICORN_ACCESS_LOG="-"
# export GUNICORN_ERROR_LOG="-"
# export GUNICORN_MAX_REQUESTS="0"
# export GUNICORN_MAX_REQUESTS_JITTER="0"
# export GUNICORN_TIMEOUT="600"
# export GUNICORN_GRACEFUL_TIMEOUT="60"
# export GUNICORN_KEEPALIVE="5"

###############################################################################
# 8) Optional copy/paste backend examples
###############################################################################

# Redis 7.0 example
# export OCI_MGMT_DASH_SESSION_BACKEND="redis"
# export OCI_MGMT_DASH_SESSION_REDIS_URL="redis://redis-7-0.default.svc.cluster.local:6379/0"
# export OCI_MGMT_DASH_SESSION_REDIS_USERNAME="default"
# export OCI_MGMT_DASH_SESSION_REDIS_PASSWORD="<redis-password>"

# Valkey 7.2 example
# export OCI_MGMT_DASH_SESSION_BACKEND="valkey"
# export OCI_MGMT_DASH_SESSION_REDIS_URL="redis://valkey-7-2.default.svc.cluster.local:6379/0"
# export OCI_MGMT_DASH_SESSION_REDIS_USERNAME="default"
# export OCI_MGMT_DASH_SESSION_REDIS_PASSWORD="<valkey-password>"

# Valkey 8.1 example
# export OCI_MGMT_DASH_SESSION_BACKEND="valkey"
# export OCI_MGMT_DASH_SESSION_REDIS_URL="redis://valkey-8-1.default.svc.cluster.local:6379/0"
# export OCI_MGMT_DASH_SESSION_REDIS_USERNAME="default"
# export OCI_MGMT_DASH_SESSION_REDIS_PASSWORD="<valkey-password>"
